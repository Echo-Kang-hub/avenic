{
  "name": "avenic-agent-manager",
  "displayName": "Avenic Agent Manager",
  "description": "Avenic for VS Code: one panel for the agents, sessions and skills this project uses.",
  "publisher": "EchoKang",
  "version": "0.6.0",
  "private": true,
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Echo-Kang-hub/avenic.git"
  },
  "main": "./dist/extension.js",
  "type": "module",
  "engines": {
    "vscode": "^1.90.0"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "avenic",
          "title": "Avenic",
          "icon": "media/icon-activity.png"
        }
      ]
    },
    "views": {
      "avenic": [
        {
          "id": "avenic.launcher",
          "name": "Avenic",
          "contextualTitle": "Avenic"
        }
      ]
    },
    "commands": [
      {
        "command": "avenic.agents.configureProject",
        "title": "Avenic: Configure Project",
        "category": "Avenic",
        "icon": "$(settings-gear)"
      },
      {
        "command": "avenic.agents.launch",
        "title": "Avenic: Launch Agent",
        "category": "Avenic",
        "icon": "$(play)"
      },
      {
        "command": "avenic.agents.install",
        "title": "Avenic: Install Agent CLI",
        "category": "Avenic",
        "icon": "$(cloud-download)"
      },
      {
        "command": "avenic.agents.update",
        "title": "Avenic: Update Agent CLI",
        "category": "Avenic",
        "icon": "$(arrow-up)"
      },
      {
        "command": "avenic.agents.deinit",
        "title": "Avenic: Remove Agent",
        "category": "Avenic",
        "icon": "$(trash)"
      },
      {
        "command": "avenic.agents.sessionsImport",
        "title": "Avenic: Import Sessions",
        "category": "Avenic"
      },
      {
        "command": "avenic.agents.sessionsWriteback",
        "title": "Avenic: Write Back Sessions",
        "category": "Avenic"
      },
      {
        "command": "avenic.dashboard.open",
        "title": "Avenic: Dashboard",
        "category": "Avenic",
        "icon": "$(layout)"
      },
      {
        "command": "avenic.sessions.open",
        "title": "Avenic: Sessions",
        "category": "Avenic",
        "icon": "$(history)"
      },
      {
        "command": "avenic.catalog.add",
        "title": "Avenic: Add Hub",
        "category": "Avenic"
      },
      {
        "command": "avenic.catalog.select",
        "title": "Avenic: Select Hub",
        "category": "Avenic"
      },
      {
        "command": "avenic.catalog.default",
        "title": "Avenic: Set Default Hub",
        "category": "Avenic"
      },
      {
        "command": "avenic.catalog.sync",
        "title": "Avenic: Sync Hub",
        "category": "Avenic"
      },
      {
        "command": "avenic.skills.installPacks",
        "title": "Avenic: Install Packs",
        "category": "Avenic"
      },
      {
        "command": "avenic.skills.uninstallPacks",
        "title": "Avenic: Uninstall Packs",
        "category": "Avenic"
      },
      {
        "command": "avenic.skills.addDirect",
        "title": "Avenic: Add Skill from Repository",
        "category": "Avenic"
      },
      {
        "command": "avenic.skills.removeDirect",
        "title": "Avenic: Remove Skill from Repository",
        "category": "Avenic"
      },
      {
        "command": "avenic.skills.directList",
        "title": "Avenic: List Repository Skills",
        "category": "Avenic"
      },
      {
        "command": "avenic.skills.adopt",
        "title": "Avenic: Adopt Unmanaged Skills",
        "category": "Avenic",
        "icon": "$(sync)"
      },
      {
        "command": "avenic.skills.adoptPack",
        "title": "Avenic: Adopt as Pack",
        "category": "Avenic",
        "icon": "$(package)"
      },
      {
        "command": "avenic.skills.uninstallPack",
        "title": "Avenic: Uninstall Pack",
        "category": "Avenic",
        "icon": "$(trash)"
      },
      {
        "command": "avenic.skills.reinstallPack",
        "title": "Avenic: Reinstall Pack",
        "category": "Avenic",
        "icon": "$(refresh)"
      },
      {
        "command": "avenic.skills.repairLinks",
        "title": "Avenic: Repair Skill Links",
        "category": "Avenic",
        "icon": "$(link)"
      },
      {
        "command": "avenic.catalog.installPack",
        "title": "Avenic: Install Pack",
        "category": "Avenic",
        "icon": "$(cloud-download)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "avenic.dashboard.open",
          "when": "view == avenic.launcher",
          "group": "navigation@1"
        },
        {
          "command": "avenic.agents.configureProject",
          "when": "view == avenic.launcher",
          "group": "navigation@2"
        },
        {
          "command": "avenic.skills.installPacks",
          "when": "view == avenic.launcher",
          "group": "navigation@3"
        }
      ],
      "commandPalette": [
        {
          "command": "avenic.dashboard.open"
        },
        {
          "command": "avenic.sessions.open"
        }
      ]
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && node build-tests.mjs",
    "package": "npm run build && vsce package --out dist/avenic-agent-manager.vsix",
    "test:visual": "node test/visual/shot.mjs --out ../../dist/dashboard-visual/shots/overview.png && node test/visual/compare.mjs --geometry ../../dist/dashboard-visual/shots/overview.geometry.json && node test/visual/matrix.mjs"
  },
  "devDependencies": {
    "@avenic/core": "file:../core",
    "@types/node": "^18.19.0",
    "@types/vscode": "^1.90.0",
    "@vscode/codicons": "^0.0.46-24",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.21.0",
    "typescript": "^5.5.0"
  }
}
