{
  "name": "avenic",
  "version": "1.8.5",
  "private": false,
  "license": "MIT",
  "description": "Portable Skills, runtime configuration, and sessions for coding agents",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Echo-Kang-hub/avenic.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/Echo-Kang-hub/avenic#readme",
  "bugs": {
    "url": "https://github.com/Echo-Kang-hub/avenic/issues"
  },
  "keywords": [
    "claude-code",
    "codex",
    "opencode",
    "agents",
    "sessions",
    "skills",
    "cli"
  ],
  "type": "module",
  "imports": {
    "#core": "./vendor/core-src/index.mjs",
    "#core/*": "./vendor/core-src/*"
  },
  "bin": {
    "avenic": "scripts/skills.mjs",
    "ave": "scripts/skills.mjs"
  },
  "scripts": {
    "prepack": "node ../../scripts/sync-core.mjs"
  },
  "files": [
    "scripts/",
    "src/",
    "vendor/core-src/"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "avenic": {
    "packageSpec": "avenic@latest"
  }
}
